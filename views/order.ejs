<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: sans-serif; background: #f0f4f9; text-align: center; }
    h1 { color: #1a73e8; }
    table { width: 700px; margin: auto; border-collapse: collapse; background: #fff; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
    th { background: #1a73e8; color: white; padding: 10px; }
    td { padding: 10px; border-bottom: 1px solid #ddd; }
    .btn { padding: 6px 12px; border-radius: 4px; text-decoration: none; color: white; font-size: 13px; }
    .btn-update { background: #1a73e8; }
    .btn-del { background: #e69500; }
    .btn-create { background: #1a73e8; padding: 10px 20px; font-weight: bold; margin-top: 20px; display: inline-block; }
  </style>
</head>
<body>
  <h1>Product Orders</h1>
  <table>
    <tr>
      <th>Customer Name</th><th>Product Name</th><th>Quantity</th><th>Order Date</th><th>Total Price</th><th>Action</th>
    </tr>
    <% orders.forEach(o => { %>
      <tr>
        <td><%= o.customerName %></td>
        <td><%= o.productName %></td>
        <td><%= o.quantity %></td>
        <td><%= new Date(o.orderDate).toLocaleDateString('en-US') %></td>
        <td><%= o.totalPrice %> VND</td>
        <td>
          <a href="/orders/update/<%= o._id %>" class="btn btn-update">Update</a>
          <a href="/orders/delete/<%= o._id %>" class="btn btn-del" onclick="return confirm('Delete this order?')">Delete</a>
        </td>
      </tr>
    <% }) %>
  </table>
  <a href="/orders/create" class="btn btn-create">Create New Order</a>
</body>
</html>