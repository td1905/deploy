<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: sans-serif; background: #f0f4f9; display: flex; justify-content: center; }
    .card { background: white; padding: 25px; border-radius: 6px; width: 350px; margin-top: 30px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    h2 { color: #1a73e8; text-align: center; }
    label { font-weight: bold; color: #1a73e8; display: block; margin-top: 10px; text-align: left; }
    input { width: 100%; padding: 8px; margin-top: 4px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px; }
    .btn { width: 100%; padding: 10px; color: white; border: none; border-radius: 4px; margin-top: 12px; cursor: pointer; display: block; text-align: center; text-decoration: none; box-sizing: border-box; }
  </style>
</head>
<body>
  <div class="card">
    <h2>Update Order</h2>
    <% if (typeof err !== 'undefined' && err) { %>
      <p style="color: red; text-align: center;"><%= err %></p>
    <% } %>
    <form action="/orders/update/<%= order._id %>" method="POST">
      <label>Customer Name</label>
      <input type="text" name="customerName" value="<%= order.customerName %>" required>

      <label>Product Name</label>
      <input type="text" name="productName" value="<%= order.productName %>" required>

      <label>Quantity</label>
      <input type="number" name="quantity" min="1" value="<%= order.quantity %>" required>

      <label>Order Date</label>
      <input type="date" name="orderDate" value="<%= new Date(order.orderDate).toISOString().slice(0, 10) %>" required>

      <button type="submit" class="btn" style="background: #1a73e8;">Update Order</button>
      <a href="/orders" class="btn" style="background: #e69500;">Go Back</a>
    </form>
  </div>
</body>
</html>